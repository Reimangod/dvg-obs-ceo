{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Reimangod/dvg-obs-ceo/schemas/telemetry-event-v1.schema.json",
  "title": "DVG-OBS-CEO hash-chained telemetry event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "sequence", "event_type", "emitted_at_utc", "previous_event_digest", "payload", "event_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "ledger_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "event_type": {"type": "string", "minLength": 1},
    "emitted_at_utc": {"type": "string", "format": "date-time"},
    "previous_event_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {"type": "object"},
    "event_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

